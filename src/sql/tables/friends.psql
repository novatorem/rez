-- Friends table definition
-- Stores friendship relationships between users
-- Uses normalized order: user_id is always the smaller UUID

CREATE TABLE IF NOT EXISTS public.friends (
  id UUID NOT NULL PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES public.users (id) ON DELETE CASCADE,
  friend_id UUID NOT NULL REFERENCES public.users (id) ON DELETE CASCADE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
  -- Ensure a user can't be friends with themselves
  CONSTRAINT check_not_self_friend CHECK (user_id != friend_id),
  -- Ensure canonical order: user_id < friend_id
  CONSTRAINT check_canonical_order CHECK (user_id < friend_id),
  -- Ensure uniqueness of friendships
  UNIQUE (user_id, friend_id)
);

-- Enable row level security
ALTER TABLE public.friends ENABLE ROW LEVEL SECURITY;

-- Create trigger to normalize friendship order before insert/update
DROP TRIGGER IF EXISTS normalize_friendship_trigger ON public.friends;
CREATE TRIGGER normalize_friendship_trigger BEFORE INSERT OR UPDATE
ON public.friends FOR EACH ROW
EXECUTE PROCEDURE public.normalize_friendship_order();

-- RLS Policies

-- Allow users to see their own friendships (both directions)
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE policyname = 'Users can see their own friends' AND tablename = 'friends' AND schemaname = 'public'
  ) THEN
    CREATE POLICY "Users can see their own friends"
    ON public.friends
    FOR SELECT
    USING (auth.uid() = user_id OR auth.uid() = friend_id);
  END IF;
END
$$;

-- Allow users to create friendship records
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE policyname = 'Users can create friendship records' AND tablename = 'friends' AND schemaname = 'public'
  ) THEN
    CREATE POLICY "Users can create friendship records"
    ON public.friends
    FOR INSERT
    WITH CHECK (
      auth.uid() = user_id OR auth.uid() = friend_id
    );
  END IF;
END
$$;

-- Allow users to delete their own friendships
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE policyname = 'Users can delete their own friendships' AND tablename = 'friends' AND schemaname = 'public'
  ) THEN
    CREATE POLICY "Users can delete their own friendships"
    ON public.friends
    FOR DELETE
    USING (
      auth.uid() = user_id OR auth.uid() = friend_id
    );
  END IF;
END
$$;

-- Create indexes for performance
CREATE INDEX IF NOT EXISTS idx_friends_user ON public.friends (user_id);
CREATE INDEX IF NOT EXISTS idx_friends_friend ON public.friends (friend_id);

