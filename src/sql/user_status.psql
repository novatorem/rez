-- Create update_timestamp function for updating the updated_at field
create or replace function update_timestamp()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

create table user_status (
  id uuid primary key default uuid_generate_v4(),
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  user_id uuid references auth.users on delete cascade not null default auth.uid(),
  status text not null check (char_length(status) <= 64),
  unique (user_id)
);

-- Create trigger for updated_at
create trigger set_timestamp before update
on user_status for each row
execute procedure update_timestamp();

alter table user_status enable row level security;

revoke all on table user_status from authenticated;
revoke all on table user_status from anon;

grant all (status, user_id) on table user_status to authenticated;
grant select (id, created_at, updated_at) on table user_status to authenticated;
grant delete on table user_status to authenticated;
grant insert on table user_status to authenticated;

-- Allow users to see everyone's status (for public statuses)
create policy "Users can see all statuses"
on user_status
for select
to authenticated
using (true);

-- Allow users to modify only their own status
create policy "Users can modify their own status"
on user_status
for all
to authenticated
using (auth.uid() = user_id);

-- Create index for performance
create index if not exists idx_user_status_user on user_status (user_id);
