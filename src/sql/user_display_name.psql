-- Add display_name column to users table
-- This allows users to set a display name that will be shown to others alongside their username

-- Add display_name column to the users table
ALTER TABLE public.users
ADD COLUMN IF NOT EXISTS display_name TEXT CHECK (char_length(display_name) <= 50);

-- Create an index on display_name for better query performance
CREATE INDEX IF NOT EXISTS idx_users_display_name ON public.users(display_name);

-- Update the handle_new_user function to set display_name to NULL initially
-- (users can set it later through the settings page)
-- No changes needed to the function as it already handles the basic user creation

-- RLS policies for display_name
-- Allow users to read all display names (for friend lists, etc.)
CREATE POLICY "Users can read all display names"
ON public.users
FOR SELECT
TO authenticated
USING (true);

-- Allow users to update only their own display name
CREATE POLICY "Users can update their own display name"
ON public.users
FOR UPDATE
TO authenticated
USING (auth.uid() = id)
WITH CHECK (auth.uid() = id);

-- Add a comment to document the display_name field
COMMENT ON COLUMN public.users.display_name IS 'User-friendly display name shown to other users. Can be different from username.';
