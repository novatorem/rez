-- Create quick_statuses table to store user's pre-defined quick status messages
CREATE TABLE IF NOT EXISTS public.quick_statuses (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  status_text TEXT NOT NULL CHECK (char_length(status_text) <= 42),
  display_order INTEGER NOT NULL CHECK (display_order >= 0 AND display_order < 5),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
  -- Ensure each user can only have one quick status per display order (0-4)
  UNIQUE (user_id, display_order),
  -- Add index for faster lookups
  CONSTRAINT fk_quick_status_user FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE
);

-- Create index for efficient user lookups
CREATE INDEX IF NOT EXISTS idx_quick_statuses_user_id ON public.quick_statuses(user_id);

-- Create index for display order
CREATE INDEX IF NOT EXISTS idx_quick_statuses_display_order ON public.quick_statuses(user_id, display_order);

-- Create trigger for updated_at
CREATE OR REPLACE FUNCTION update_quick_status_timestamp()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_trigger WHERE tgname = 'set_quick_status_timestamp'
  ) THEN
    CREATE TRIGGER set_quick_status_timestamp BEFORE UPDATE
    ON public.quick_statuses FOR EACH ROW
    EXECUTE PROCEDURE update_quick_status_timestamp();
  END IF;
END
$$;

-- Enable row level security
ALTER TABLE public.quick_statuses ENABLE ROW LEVEL SECURITY;

-- RLS policies

-- Users can view their own quick statuses
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE policyname = 'Users can view their own quick statuses'
  ) THEN
    CREATE POLICY "Users can view their own quick statuses"
    ON public.quick_statuses
    FOR SELECT
    USING (auth.uid() = user_id);
  END IF;
END
$$;

-- Users can insert their own quick statuses (up to 5)
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE policyname = 'Users can insert their own quick statuses'
  ) THEN
    CREATE POLICY "Users can insert their own quick statuses"
    ON public.quick_statuses
    FOR INSERT
    WITH CHECK (auth.uid() = user_id);
  END IF;
END
$$;

-- Users can update their own quick statuses
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE policyname = 'Users can update their own quick statuses'
  ) THEN
    CREATE POLICY "Users can update their own quick statuses"
    ON public.quick_statuses
    FOR UPDATE
    USING (auth.uid() = user_id);
  END IF;
END
$$;

-- Users can delete their own quick statuses
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE policyname = 'Users can delete their own quick statuses'
  ) THEN
    CREATE POLICY "Users can delete their own quick statuses"
    ON public.quick_statuses
    FOR DELETE
    USING (auth.uid() = user_id);
  END IF;
END
$$;

-- Insert default quick statuses for new users
CREATE OR REPLACE FUNCTION public.handle_new_user_quick_statuses()
RETURNS TRIGGER AS $$
BEGIN
  -- Insert default quick statuses
  INSERT INTO public.quick_statuses (user_id, status_text, display_order)
  VALUES
    (NEW.id, 'Travelling', 0),
    (NEW.id, 'Sleeping', 1),
    (NEW.id, 'Working', 2),
    (NEW.id, 'Lounging', 3);
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER SET search_path = '';

-- Create trigger for new users
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_trigger WHERE tgname = 'on_auth_user_created_quick_statuses'
  ) THEN
    CREATE TRIGGER on_auth_user_created_quick_statuses
    AFTER INSERT ON auth.users
    FOR EACH ROW
    EXECUTE PROCEDURE public.handle_new_user_quick_statuses();
  END IF;
END
$$;

